# 复制成 server/.env 后按需修改（首次使用：cp .env.example .env）
DB_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# 生产环境务必换成随机长字符串，不要沿用下面这个默认值
JWT_SECRET="change-me-to-a-random-long-string"

PORT=3000

# MySQL 一键切换用（执行 npm run db:use:mysql 时会自动写入 DATABASE_URL）
# MYSQL_URL="mysql://user:password@localhost:3306/clothing_store"
# MYSQL_USER="user"
# MYSQL_PASSWORD="password"
# MYSQL_HOST="localhost"
# MYSQL_PORT="3306"
# MYSQL_DATABASE="clothing_store"
