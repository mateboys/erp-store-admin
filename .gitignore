node_modules/
dist/
server/uploads/*
!server/uploads/.gitkeep
*.log
.DS_Store

# ---------- 不进版本库的敏感/本地文件 ----------
# 环境变量：里面是真实的 JWT_SECRET 和数据库连接串，改不了的一律不入库
.env
.env.local
.env.*.local
!.env.example

# SQLite 库与历次备份：里面有真实门店/商品/销售数据。
# 新环境执行 `npx prisma db push` 会自动建库并写入种子数据，不需要这份文件
server/prisma/*.db
server/prisma/*.db-*
server/prisma/*.sqlite
server/prisma/*.bak*

# WorkBuddy 本地工作数据（会话记忆等）
.workbuddy/
