node_modules/
dist/
server/uploads/*
!server/uploads/.gitkeep
*.log
.DS_Store

# ---------- 不进版本库的敏感/本地文件 ----------
# 环境变量：里面是真实的 JWT_SECRET 和数据库连接串，改不了的一律不入库
.env
.env.local
.env.*.local
!.env.example

# SQLite 库：主库 dev.db 进版本库（里面是演示数据，克隆下来即可直接看到完整效果）
# 只排除运行期伴生文件（WAL/SHM）与历次本地备份
server/prisma/dev.db-wal
server/prisma/dev.db-shm
server/prisma/*.db-*
server/prisma/*.sqlite
server/prisma/*.bak*
!server/prisma/dev.db

# WorkBuddy 本地工作数据（会话记忆等）
.workbuddy/

# vite 生成的临时配置文件（含本机绝对路径，不应入库）
web/vite.config.js.timestamp-*.mjs
